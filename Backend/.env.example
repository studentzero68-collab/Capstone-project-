# Copy this file to .env and fill in your values
# On Render, set these as Environment Variables in the dashboard

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/zero-airbnb
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Set this to your Render frontend URL so CORS works
# e.g. https://zero-frontend.onrender.com
FRONTEND_URL=https://your-frontend.onrender.com
